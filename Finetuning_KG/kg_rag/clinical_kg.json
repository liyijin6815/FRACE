      },
      "解释_脑积水": {
        "type": "Interpretation",
        "text": "提示脑积水，需排查导水管狭窄、生发基质出血或脊柱裂等"
      },
      "解释_Dandy-Walker": {
        "type": "Interpretation",
        "text": "提示Dandy-Walker畸形或变异，需结合小脑蚓部形态综合评估"
      },
      "解释_脉络丛囊肿": {
